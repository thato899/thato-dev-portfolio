// Prisma schema for the portfolio's projects & events content.
//
// Postgres everywhere (dev and prod) via a free Neon database — see the
// README for setup. `DATABASE_URL` in .env / .env.local points at it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  tagline     String
  description String
  content     String?
  techStack   String // comma-separated, e.g. "Next.js, Prisma, PostgreSQL"
  liveUrl     String?
  githubUrl   String?
  imageUrl    String?
  featured    Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String
  story       String?
  category    String    @default("Community Outreach")
  date        DateTime?
  location    String?
  imageUrl    String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
